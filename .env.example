# Environment contract for the two edge functions. Copy to .env for local work.
#
# There are exactly two functions and no database, accounts or sessions:
#   api/geo.ts          takes NO configuration at all. It reads a country code
#                       off a request header Vercel sets. Nothing to set, and
#                       nothing to get wrong.
#   api/send-contact.ts needs the four below, two of them required.
#
# This file previously said the site needed no environment variables. That was
# true for the hours that send-contact.ts was deleted, and is no longer.


# ── REQUIRED. Without either of these the contact form cannot send. ──────────

# Resend API key, for delivering submissions to the team inbox.
# MISSING: logs {"evt":"contact.misconfigured","missing":"RESEND_API_KEY"} and
# answers 502-style copy at 500, so the visitor is told plainly and handed the
# two published addresses instead of hitting a dead end. It fails at the first
# request rather than at deploy time, because an edge function has no startup.
# ROTATE THIS. The previous value was committed to git history.
RESEND_API_KEY=

# Cloudflare Turnstile secret, server side. The bot check that replaced an
# in-memory rate limiter which could not survive a cold start.
# MISSING: same behaviour as above, logged with missing="TURNSTILE_SECRET_KEY".
# Deliberately fails closed. An unconfigured deploy must not quietly become the
# open relay this endpoint was once deleted for being.
TURNSTILE_SECRET_KEY=


# ── REQUIRED AT BUILD TIME, by the form rather than by the function. ─────────

# Turnstile PUBLIC site key. Vite inlines VITE_ prefixed vars into the client
# bundle at build time, so this one is public by design and is not a secret.
# MISSING: the widget cannot render, so the form produces no token, so every
# submission is rejected 403 "Verification failed". This is the failure mode
# that looks like a bug rather than a misconfiguration, because the function is
# working exactly as intended and the log will say "turnstile", not "missing".
# Check this first if submissions 403 in bulk.
VITE_TURNSTILE_SITE_KEY=


# ── OPTIONAL. Both have working defaults and fall back silently. ─────────────

# Sender address. Defaults to Resend's shared sandbox sender, which is fine for
# testing and unreliable for delivery to arbitrary recipients. Set this to an
# address on a domain verified in Resend before relying on it.
RESEND_FROM="Ziiro AI <onboarding@resend.dev>"

# Where submissions are delivered. Defaults to ziiro.work@gmail.com.
# NOT the same as the two published addresses a visitor is shown when a send
# fails; those are in api/_lib.ts as PUBLIC_CONTACT_EMAILS.
TEAM_INBOX=ziiro.work@gmail.com
